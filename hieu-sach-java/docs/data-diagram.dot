digraph DataDiagram {
graph [rankdir=LR, bgcolor=white, pad=0.4, nodesep=0.4, ranksep=1.1, fontname=Arial, label="DATA DIAGRAM - 11 BẢNG MYSQL\nPK là khóa chính. FK là khóa ngoại.", labelloc=t, fontsize=18];
